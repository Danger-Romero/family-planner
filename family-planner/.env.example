# First set up Family/Member/Item, the Member.user index and permissions (see README).
# Copy this file to .env.local and use your family's Back4App app values:
# Back4App dashboard > App Settings > Security & Keys
# Use the Application ID and JavaScript key, never the master key.
VITE_PARSE_SERVER_URL=https://parseapi.back4app.com
VITE_PARSE_APP_ID=your-application-id-here
VITE_PARSE_JS_KEY=your-javascript-key-here
